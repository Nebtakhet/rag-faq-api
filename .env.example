# Copy this file to .env and replace placeholder values.

# Required for embeddings and answer generation.
OPENAI_API_KEY=sk-your-real-key

# Required for /admin/* endpoints.
ADMIN_API_KEY=my-admin-secret

# Optional upload limit per file in bytes (default: 5242880 = 5MB).
MAX_UPLOAD_BYTES=5242880

# Optional DB URL used by Alembic and docker-compose overrides.
# Local default fallback is defined in alembic.ini.
# SQLALCHEMY_DATABASE_URI=sqlite:///./app.db

# Optional cache URL used in docker-compose.
# REDIS_URL=redis://redis:6379/0

# Optional legacy keys used by CI migration env.
# SECRET_KEY=replace-with-long-random-secret
# REFRESH_TOKEN_SECRET=replace-with-long-random-secret
# AUTO_CREATE_SCHEMA=false
